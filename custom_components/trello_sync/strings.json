from __future__ import annotations

import logging
from datetime import datetime

from homeassistant.components.todo import TodoEntity, TodoItem, TodoItemStatus
from homeassistant.config_entries import ConfigEntry
from homeassistant.core import HomeAssistant
from homeassistant.helpers.entity_platform import AddEntitiesCallback

from .coordinator import TrelloSyncCoordinator

_LOGGER = logging.getLogger(__name__)


async def async_setup_entry(
    hass: HomeAssistant,
    config_entry: ConfigEntry,
    async_add_entities: AddEntitiesCallback,
) -> None:
    """Set up Trello todo entities from a config entry."""
    coordinator: TrelloSyncCoordinator = hass.data["trello_sync"][config_entry.entry_id]["coordinator"]
    async_add_entities([TrelloTodoEntity(config_entry, coordinator)], True)


class TrelloTodoEntity(TodoEntity):
    """An HA todo entity backed by a Trello board."""

    _attr_has_entity_name = True
    _attr_name = "Trello Tasks"

    def __init__(self, config_entry: ConfigEntry, coordinator: TrelloSyncCoordinator) -> None:
        self._config_entry = config_entry
        self.coordinator = coordinator
        self._attr_unique_id = f"trello_sync_{config_entry.entry_id}_todo"

    @property
    def available(self) -> bool:
        return self.coordinator.last_update_success

    @property
    def todo_items(self) -> list[TodoItem]:
        items: list[TodoItem] = []
        for card in self.coordinator.list_cards():
            card_id = card.get("id")
            if not card_id:
                continue

            due = None
            due_raw = card.get("due")
            if due_raw:
                try:
                    due = datetime.fromisoformat(due_raw.replace("Z", "+00:00"))
                except ValueError:
                    due = None

            status = TodoItemStatus.NEEDS_ACTION
            if card.get("status") == "completed":
                status = TodoItemStatus.COMPLETED

            items.append(
                TodoItem(
                    summary=str(card.get("name", "")),
                    uid=str(card_id),
                    status=status,
                    due=due,
                    description=str(card.get("description") or ""),
                )
            )
        return items

    async def async_create_todo_item(self, item: TodoItem) -> None:
        default_list = self.coordinator.get_list_id_for_name("To Do")
        if default_list is None:
            default_list = self.coordinator.data.get("lists", [{}])[0].get("id")

        await self.hass.async_add_executor_job(
            self.coordinator.api.create_card,
            item.summary,
            item.description or "",
            default_list,
            item.due.isoformat() if item.due else None,
        )
        await self.coordinator.async_request_refresh()

    async def async_update_todo_item(self, item: TodoItem) -> None:
        await self.hass.async_add_executor_job(
            self.coordinator.api.update_card,
            item.uid,
            name=item.summary,
            desc=item.description or "",
            due=item.due.isoformat() if item.due else None,
            closed=item.status == TodoItemStatus.COMPLETED,
        )
        await self.coordinator.async_request_refresh()

    async def async_delete_todo_item(self, uid: str) -> None:
        await self.hass.async_add_executor_job(self.coordinator.api.delete_card, uid)
        await self.coordinator.async_request_refresh()

    async def async_added_to_hass(self) -> None:
        await super().async_added_to_hass()
        self.async_on_remove(self.coordinator.async_add_listener(self.async_write_ha_state))
        await self.coordinator.async_config_entry_first_refresh()

